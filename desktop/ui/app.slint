// The main window, laid out as the macOS app (myUpscaler/Views/ContentView): a toolbar (Import; adjustments panel,
// Settings, About), the media pane with the processing details under it, the adjustments panel docked on the right,
// and the bottom bar with the status and the Export button. Settings and About open as sheets, and a double-clicked
// preview fills the window. The macOS app's keyboard shortcuts work on every platform (Ctrl for ⌘).

import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme, ThemePreference } from "theme.slint";
import { Settings, App, Actions } from "globals.slint";
import { ToolbarButton, Button, ButtonKind } from "controls.slint";
import { Divider, FormSection, FormRow, ChoiceRow } from "components.slint";
import { Inspector } from "inspector.slint";
import { MediaPane, LogPane, BottomBar } from "workspace.slint";

export { Settings, App, Actions, Theme }

component Toolbar inherits Rectangle {
    background: Theme.bar;
    height: App.toolbar-height;
    // On macOS this is the window's title bar: the empty part moves the window and a double click zooms it.
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                Actions.toolbar-press();
            }
        }
    }
    HorizontalLayout {
        padding-left: 8px + App.toolbar-inset;
        padding-right: 8px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            ToolbarButton {
                icon: @image-url("icons/import.svg");
                label: "Import";
                text: "Import";
                enabled: !App.running;
                clicked => { Actions.import(); }
            }
        }
        // The video's name (macOS: the window title is not drawn) and the state of its preview.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            if App.mac || App.input-path != "": Text {
                text: App.input-name != "" ? App.input-name : "myUpscaler";
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
                overflow: elide;
            }
            if App.input-path != "": Text {
                text: App.running ? "Preview frozen while processing"
                    : App.preview-busy && App.has-preview ? "Updating preview…" : "Approximate preview";
                font-size: Theme.subheadline;
                color: Theme.secondary;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            ToolbarButton {
                icon: @image-url("icons/sidebar.svg");
                label: App.inspector-visible ? "Hide adjustments panel" : "Show adjustments panel";
                active: App.inspector-visible;
                clicked => { App.inspector-visible = !App.inspector-visible; }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolbarButton {
                icon: @image-url("icons/settings.svg");
                label: "Settings";
                clicked => { App.settings-open = true; }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolbarButton {
                icon: @image-url("icons/info.svg");
                label: "About";
                clicked => { App.about-open = true; }
            }
        }
    }
    Divider {
        y: parent.height - 1px;
        width: parent.width;
    }
}

// A modal sheet: the window behind it is dimmed and does not take clicks.
component Sheet inherits Rectangle {
    in property <length> sheet-width: 420px;
    callback close();
    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: root.sheet-width;
        height: min(content.preferred-height, root.height - 40px);
        background: Theme.window;
        border-radius: Theme.control-radius;
        border-width: 1px;
        border-color: Theme.control-border;
        clip: true;
        TouchArea { }
        content := VerticalLayout {
            padding: 20px;
            spacing: Theme.md;
            @children
        }
    }
}

component SettingsSheet inherits Sheet {
    sheet-width: 460px;
    property <string> cmd: App.mac ? "⌘" : "Ctrl+";
    property <string> shift: App.mac ? "⇧" : "Shift+";
    property <string> option: App.mac ? "⌥" : "Alt+";
    FormSection {
        title: "Commands";
        for command in [
            { name: "Export video", keys: root.cmd + "R" },
            { name: "Cancel processing", keys: root.cmd + "." },
            { name: "Settings", keys: root.cmd + "," },
            { name: "About myUpscaler", keys: root.shift + root.cmd + "I" },
            { name: "Import video or folder", keys: root.cmd + "O" },
            { name: "Choose output folder", keys: root.shift + root.cmd + "O" },
            { name: "Show or hide adjustments", keys: root.option + root.cmd + "I" },
        ]: FormRow {
            label: command.name;
            Text {
                text: command.keys;
                font-size: Theme.body;
                color: Theme.secondary;
            }
        }
    }
    Divider { }
    FormSection {
        ChoiceRow {
            label: "Appearance";
            choices: ["System", "Light", "Dark"];
            menu-width: 110px;
            index: Theme.preference == ThemePreference.light ? 1 : Theme.preference == ThemePreference.dark ? 2 : 0;
            changed => {
                Theme.preference = self.index == 1 ? ThemePreference.light
                    : self.index == 2 ? ThemePreference.dark : ThemePreference.system;
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        Button {
            text: "Done";
            kind: ButtonKind.prominent;
            clicked => { App.settings-open = false; }
        }
    }
}

component AboutSheet inherits Sheet {
    HorizontalLayout {
        spacing: Theme.md;
        Image {
            source: @image-url("icons/app-icon.png");
            width: 64px;
            height: 64px;
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.xs;
            Text {
                text: "myUpscaler";
                font-size: Theme.title2;
                font-weight: 600;
                color: Theme.text;
            }
            Text {
                text: "Version " + App.version;
                font-size: Theme.body;
                color: Theme.secondary;
            }
            Text {
                text: "MpVFX media engine " + App.engine-version;
                font-size: Theme.body;
                color: Theme.secondary;
            }
        }
    }
    Text {
        text: "Video restoration and upscaling for macOS, Windows and Linux.";
        font-size: Theme.body;
        color: Theme.text;
        wrap: word-wrap;
    }
    AboutSlint {
        height: 120px;
    }
    HorizontalLayout {
        spacing: Theme.sm;
        Button {
            text: "GitHub repository";
            clicked => { Actions.open-website(); }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Close";
            kind: ButtonKind.prominent;
            clicked => { App.about-open = false; }
        }
    }
}

export component AppWindow inherits Window {
    title: App.input-name == "" ? "myUpscaler" : App.input-name + " — myUpscaler";
    icon: @image-url("icons/app-icon.png");
    min-width: 720px;
    min-height: 600px;
    preferred-width: 1180px;
    preferred-height: 780px;
    background: Theme.window;
    default-font-family: Theme.font;
    default-font-size: Theme.body;
    forward-focus: keys;

    // The built-in widgets follow Slint's palette: keep it in step with the appearance setting.
    property <ThemePreference> appearance: Theme.preference;
    changed appearance => {
        Palette.color-scheme = self.appearance == ThemePreference.dark ? ColorScheme.dark
            : self.appearance == ThemePreference.light ? ColorScheme.light : ColorScheme.unknown;
    }
    property <bool> modal: App.settings-open || App.about-open || App.enlarged;
    // The window's title bar follows the colours of the interface.
    property <bool> dark: Theme.dark;
    changed dark => { Actions.appearance-changed(); }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                if App.enlarged || App.settings-open || App.about-open {
                    App.enlarged = false;
                    App.settings-open = false;
                    App.about-open = false;
                    return accept;
                }
                return reject;
            }
            if e.text == " " && !e.modifiers.control && !root.modal && App.can-play && !App.running {
                Actions.play-pause();
                return accept;
            }
            if !e.modifiers.control || root.modal {
                return reject;
            }
            if e.text == "r" && !e.modifiers.shift && !App.running && App.input-path != "" {
                Actions.run();
                return accept;
            }
            if e.text == "." && App.running && !App.cancelling {
                Actions.cancel();
                return accept;
            }
            if e.text == "," {
                App.settings-open = true;
                return accept;
            }
            if (e.text == "i" || e.text == "I") && e.modifiers.alt {
                App.inspector-visible = !App.inspector-visible;
                return accept;
            }
            if (e.text == "i" || e.text == "I") && e.modifiers.shift {
                App.about-open = true;
                return accept;
            }
            if (e.text == "o" || e.text == "O") && !App.running {
                if e.modifiers.shift {
                    Actions.choose-output-folder();
                } else {
                    Actions.import();
                }
                return accept;
            }
            reject
        }

        VerticalLayout {
            Toolbar { }
            HorizontalLayout {
                vertical-stretch: 1;
                VerticalLayout {
                    horizontal-stretch: 1;
                    MediaPane {
                        vertical-stretch: 1;
                    }
                    LogPane { }
                }
                if App.inspector-visible: Rectangle {
                    width: 1px;
                    background: Theme.separator;
                }
                // 440 wide when the window has room for it, down to 320 in a small window.
                if App.inspector-visible: Inspector {
                    min-width: 320px;
                    preferred-width: 440px;
                    max-width: 440px;
                }
            }
            if App.input-path != "" || App.running: BottomBar { }
        }
    }

    // The enlarged preview covers the window.
    if App.enlarged: Rectangle {
        background: #000000;
        TouchArea { double-clicked => { App.enlarged = false; } }
        VerticalLayout {
            padding: Theme.md;
            spacing: Theme.sm;
            Rectangle {
                vertical-stretch: 1;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: App.preview;
                    image-fit: contain;
                }
            }
            Text {
                text: "Double-click or press Esc to close";
                font-size: Theme.subheadline;
                color: #b4b4b4;
                horizontal-alignment: center;
            }
        }
    }

    if App.settings-open: SettingsSheet {
        close => { App.settings-open = false; }
    }
    if App.about-open: AboutSheet {
        close => { App.about-open = false; }
    }
}
