// The main window. The preview is the workspace: a sunken canvas filling the window, with a floating toolbar for the
// view and a floating command bar for the timeline, the key settings and Run. The adjustments panel docks on the
// right; the log is a drawer under the canvas. About and Settings open as sheets.

import { ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import { Theme, ThemePreference } from "theme.slint";
import { Settings, App, Actions } from "globals.slint";
import { IconButton, Button, ButtonKind, Chip, Tabs, SliderControl, ProgressLine, EmptyState, Divider, ChoiceRow, Hint } from "components.slint";
import { Inspector } from "inspector.slint";

export { Settings, App, Actions, Theme }

component TitleBar inherits Rectangle {
    height: 44px;
    background: Theme.background;
    HorizontalLayout {
        padding-left: Theme.md;
        padding-right: Theme.sm;
        spacing: Theme.sm;
        HorizontalLayout {
            spacing: Theme.sm;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 6px;
                    background: Theme.accent;
                    Image {
                        source: @image-url("icons/upscale.svg");
                        width: 14px;
                        colorize: Theme.on-accent;
                    }
                }
            }
            Text {
                text: "myUpscaler";
                font-size: Theme.font-body;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            if App.input-name != "": Text {
                text: "/";
                color: Theme.faint;
                vertical-alignment: center;
            }
            if App.input-name != "": Text {
                text: App.input-name;
                font-size: Theme.font-body;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
                max-width: 360px;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/import.svg");
                label: "Import";
                enabled: !App.running;
                clicked => { Actions.import(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 1px;
                height: 18px;
                background: Theme.hairline;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/terminal.svg");
                active: App.log-open;
                accessible-label: "Log";
                clicked => { App.log-open = !App.log-open; }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/sidebar.svg");
                active: App.inspector-visible;
                accessible-label: App.inspector-visible ? "Hide adjustments" : "Show adjustments";
                clicked => { App.inspector-visible = !App.inspector-visible; }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/settings.svg");
                accessible-label: "Settings";
                clicked => { App.settings-open = true; }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/info.svg");
                accessible-label: "About";
                clicked => { App.about-open = true; }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }
}

// A translucent panel floating over the canvas.
component Floating inherits Rectangle {
    background: Theme.floating;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 6px;
}

component ViewToolbar inherits Floating {
    height: 38px;
    width: layout.preferred-width;
    opacity: App.running ? 0.6 : 1;
    layout := HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        Tabs {
            width: 170px;
            enabled: !App.running;
            items: ["Original", "Filtered"];
            selected: App.show-processed ? 1 : 0;
            changed(i) => {
                App.show-processed = i == 1;
                Actions.refresh-preview();
            }
        }
        if App.input-info != "": Rectangle {
            width: 1px;
            background: Theme.hairline;
        }
        if App.input-info != "": HorizontalLayout {
            padding-left: 6px;
            padding-right: Theme.sm;
            Text {
                text: App.input-info;
                font-family: Theme.mono;
                font-size: Theme.font-small;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
                max-width: 380px;
            }
        }
    }
}

component CommandBar inherits Floating {
    height: layout.preferred-height;
    property <bool> video: !App.is-image && App.duration > 0;
    layout := VerticalLayout {
        padding: Theme.sm;
        padding-left: Theme.md;
        spacing: Theme.sm;
        if App.running: ProgressLine {
            progress: App.progress;
            indeterminate: !App.progress-known;
        }
        if root.video && !App.running: HorizontalLayout {
            spacing: Theme.md;
            height: 20px;
            Text {
                text: App.position-text;
                font-family: Theme.mono;
                font-size: Theme.font-small;
                color: Theme.text;
                vertical-alignment: center;
                width: 64px;
            }
            SliderControl {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: App.duration;
                step: 0.04;
                value: App.position;
                label: "Preview position";
                released(v) => {
                    App.position = v;
                    Actions.seek(v);
                }
            }
            Text {
                text: App.duration-text;
                font-family: Theme.mono;
                font-size: Theme.font-small;
                color: Theme.muted;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 64px;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            height: 30px;
            if !App.running: VerticalLayout {
                alignment: center;
                Chip {
                    label: "Scale";
                    value: Settings.scale + "×";
                    clicked => {
                        App.inspector-visible = true;
                        App.page = 0;
                    }
                }
            }
            if !App.running && !App.is-image: VerticalLayout {
                alignment: center;
                Chip {
                    label: "FPS";
                    value: Settings.fps;
                    clicked => {
                        App.inspector-visible = true;
                        App.page = 0;
                    }
                }
            }
            if !App.running && !App.is-image: VerticalLayout {
                alignment: center;
                Chip {
                    label: "CRF";
                    value: Settings.crf.round();
                    clicked => {
                        App.inspector-visible = true;
                        App.page = 0;
                    }
                }
            }
            if !App.running: VerticalLayout {
                alignment: center;
                Chip {
                    label: "Denoise";
                    value: ["off", "BM3D", "hqdn3d", "NLMeans", "ATA"][Settings.denoiser];
                    clicked => {
                        App.inspector-visible = true;
                        App.page = 1;
                    }
                }
            }
            if App.running: Text {
                text: App.phase;
                font-size: Theme.font-body;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            if App.running: Text {
                text: (App.progress-known ? (App.progress * 100).round() + "%" : "…") + "   " + App.fps-text + " fps   " + App.time-text + "   ETA " + App.eta-text;
                font-family: Theme.mono;
                font-size: Theme.font-small;
                color: Theme.muted;
                vertical-alignment: center;
            }
            if !App.running && App.phase != "Ready": Text {
                text: App.phase;
                font-size: Theme.font-small;
                font-weight: 500;
                color: App.error != "" ? Theme.danger : App.phase == "Completed" ? Theme.success : Theme.muted;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Rectangle { horizontal-stretch: App.running || App.phase == "Ready" ? 1 : 0; }
            if !App.running: Button {
                text: "Run";
                icon: @image-url("icons/play.svg");
                enabled: App.input-path != "";
                clicked => { Actions.run(); }
            }
            if App.running: Button {
                text: App.cancelling ? "Cancelling…" : "Cancel";
                icon: @image-url("icons/stop.svg");
                kind: ButtonKind.secondary;
                enabled: !App.cancelling;
                clicked => { Actions.cancel(); }
            }
        }
    }
}

component Canvas inherits Rectangle {
    background: Theme.canvas;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.hairline;
    clip: true;
    if App.input-path == "": EmptyState {
        icon: @image-url("icons/video.svg");
        title: "Restore and upscale";
        message: "Import a video or image, or a folder to process every file in it. Everything runs on this computer.";
        HorizontalLayout {
            alignment: center;
            spacing: Theme.sm;
            Button {
                text: "Import…";
                icon: @image-url("icons/import.svg");
                enabled: !App.running;
                clicked => { Actions.import(); }
            }
            Button {
                text: "Batch folder…";
                icon: @image-url("icons/folder.svg");
                kind: ButtonKind.secondary;
                enabled: !App.running;
                clicked => { Actions.import-folder(); }
            }
        }
    }
    if App.has-preview: Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: App.preview;
        image-fit: contain;
    }
    if App.input-path != "" && !App.has-preview && App.preview-note != "": Text {
        text: App.preview-note;
        color: Theme.muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: parent.width - 2 * Theme.xl;
    }
    if App.running: Rectangle {
        background: Theme.canvas.with-alpha(0.55);
    }
    if App.input-path != "": ViewToolbar {
        x: (parent.width - self.width) / 2;
        y: Theme.md;
    }
    if App.preview-busy: Floating {
        x: parent.width - self.width - Theme.md;
        y: Theme.md;
        width: busy.preferred-width;
        height: 30px;
        busy := HorizontalLayout {
            padding-left: Theme.sm;
            padding-right: Theme.sm;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    opacity: 0.4 + 0.6 * Math.abs(Math.sin(animation-tick() / 600ms * 180deg));
                }
            }
            Text {
                text: "Rendering preview";
                font-size: Theme.font-small;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
    }
    if App.input-path != "": CommandBar {
        x: Theme.md;
        width: parent.width - 2 * Theme.md;
        y: parent.height - self.height - Theme.md;
    }
}

component LogDrawer inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.hairline;
    VerticalLayout {
        padding: Theme.sm;
        padding-left: Theme.md;
        spacing: Theme.xs;
        HorizontalLayout {
            height: 22px;
            Text {
                text: "LOG";
                font-family: Theme.mono;
                font-size: Theme.font-label;
                font-weight: 500;
                letter-spacing: 0.6px;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                icon: @image-url("icons/reset.svg");
                label: "Clear";
                icon-size: 12px;
                height: 22px;
                clicked => { Actions.clear-log(); }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            content-y: min(0px, self.visible-height - log-text.preferred-height);
            log-text := Text {
                width: parent.width - Theme.lg;
                text: App.log == "" ? "Messages from the engine appear here." : App.log;
                font-family: Theme.mono;
                font-size: 11px;
                color: App.log == "" ? Theme.faint : Theme.muted;
                wrap: word-wrap;
            }
        }
    }
}

// A modal sheet: dimmed backdrop, centred card.
component Sheet inherits Rectangle {
    in property <length> card-width: 420px;
    callback close();
    background: #0000008c;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: root.card-width;
        height: content.preferred-height;
        background: Theme.panel;
        border-radius: Theme.radius-large;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 10px;
        TouchArea { }
        content := VerticalLayout {
            padding: Theme.xl;
            spacing: Theme.md;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: App.input-name == "" ? "myUpscaler" : App.input-name + " — myUpscaler";
    icon: @image-url("icons/upscale.svg");
    min-width: 760px;
    min-height: 560px;
    preferred-width: 1240px;
    preferred-height: 800px;
    background: Theme.background;
    default-font-family: Theme.font;
    default-font-size: Theme.font-body;

    // The built-in widgets follow Slint's palette: keep it in step with the appearance setting.
    property <ThemePreference> appearance: Theme.preference;
    changed appearance => {
        Palette.color-scheme = self.appearance == ThemePreference.dark ? ColorScheme.dark
            : self.appearance == ThemePreference.light ? ColorScheme.light : ColorScheme.unknown;
    }

    VerticalLayout {
        TitleBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            VerticalLayout {
                horizontal-stretch: 1;
                padding: Theme.md;
                spacing: Theme.md;
                Canvas {
                    vertical-stretch: 1;
                    min-height: 300px;
                }
                if App.log-open: LogDrawer {
                    height: 150px;
                }
            }
            if App.inspector-visible: Inspector {
                min-width: 300px;
                preferred-width: 360px;
                max-width: 360px;
                horizontal-stretch: 0;
            }
        }
    }

    if App.about-open: Sheet {
        close => { App.about-open = false; }
        Text {
            text: "myUpscaler";
            font-size: Theme.font-title;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: "Video restoration and upscaling for macOS, Windows and Linux. The processing engine is written in Rust; media engine: MpVFX " + App.engine-version + ".";
            font-size: Theme.font-body;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Divider { }
        AboutSlint {
            height: 150px;
        }
        HorizontalLayout {
            alignment: center;
            Button {
                text: "Close";
                has-icon: false;
                kind: ButtonKind.secondary;
                width: 120px;
                clicked => { App.about-open = false; }
            }
        }
    }

    if App.settings-open: Sheet {
        close => { App.settings-open = false; }
        Text {
            text: "Settings";
            font-size: Theme.font-title;
            font-weight: 600;
            color: Theme.text;
        }
        ChoiceRow {
            label: "Appearance";
            choices: ["System", "Light", "Dark"];
            index: Theme.preference == ThemePreference.light ? 1 : Theme.preference == ThemePreference.dark ? 2 : 0;
            changed => {
                Theme.preference = self.index == 1 ? ThemePreference.light
                    : self.index == 2 ? ThemePreference.dark : ThemePreference.system;
            }
        }
        Hint { text: "Processing settings are in the adjustments panel."; }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Done";
                has-icon: false;
                width: 100px;
                clicked => { App.settings-open = false; }
            }
        }
    }
}
