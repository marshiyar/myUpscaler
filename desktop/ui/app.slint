// The main window, laid out as the macOS app (myUpscaler/Views/ContentView): a toolbar (Import; adjustments panel,
// Settings, About), the input and processing-details cards, the adjustments panel docked on the right, and the
// progress bar with the Export button at the bottom. Settings and About open as sheets, and a double-clicked
// preview fills the window. The macOS app's keyboard shortcuts work on every platform (Ctrl for ⌘).

import { AboutSlint, Palette, ScrollView } from "std-widgets.slint";
import { Theme, ThemePreference } from "theme.slint";
import { Settings, App, Actions } from "globals.slint";
import { ToolbarButton, Button, ButtonKind, ButtonSize } from "controls.slint";
import { Divider, FormSection, FormRow, ChoiceRow } from "components.slint";
import { Inspector } from "inspector.slint";
import { InputCard, LogCard, BottomBar } from "workspace.slint";

export { Settings, App, Actions, Theme }

component Toolbar inherits Rectangle {
    background: Theme.bar;
    height: Theme.toolbar-height;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            ToolbarButton {
                icon: @image-url("icons/import.svg");
                label: "Import";
                enabled: !App.running;
                clicked => { Actions.import(); }
            }
        }
        Text {
            text: "myUpscaler";
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            ToolbarButton {
                icon: @image-url("icons/sidebar.svg");
                label: App.inspector-visible ? "Hide adjustments panel" : "Show adjustments panel";
                active: App.inspector-visible;
                clicked => { App.inspector-visible = !App.inspector-visible; }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolbarButton {
                icon: @image-url("icons/settings.svg");
                label: "Settings";
                clicked => { App.settings-open = true; }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolbarButton {
                icon: @image-url("icons/info.svg");
                label: "About";
                clicked => { App.about-open = true; }
            }
        }
    }
    Divider {
        y: parent.height - 1px;
        width: parent.width;
    }
}

// A modal sheet: dimmed backdrop, centred panel.
component Sheet inherits Rectangle {
    in property <length> sheet-width: 450px;
    callback close();
    background: #00000066;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: root.sheet-width;
        height: min(content.preferred-height, root.height - 40px);
        background: Theme.window;
        border-radius: 12px;
        border-width: 0.5px;
        border-color: Theme.control-border;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 12px;
        clip: true;
        TouchArea { }
        content := VerticalLayout {
            @children
        }
    }
}

component ShortcutBadge inherits Rectangle {
    in property <string> keys;
    background: Theme.card;
    border-radius: 6px;
    width: label.preferred-width + 16px;
    height: 24px;
    label := Text {
        text: root.keys;
        font-family: Theme.mono;
        font-size: Theme.body;
        color: Theme.text;
    }
}

component SettingsSheet inherits Sheet {
    sheet-width: 540px;
    property <string> cmd: App.mac ? "⌘" : "Ctrl+";
    property <string> shift: App.mac ? "⇧" : "Shift+";
    property <string> option: App.mac ? "⌥" : "Alt+";
    HorizontalLayout {
        padding: 12px;
        alignment: end;
        Button {
            text: "Done";
            icon: @image-url("icons/check.svg");
            has-icon: true;
            kind: ButtonKind.prominent;
            clicked => { App.settings-open = false; }
        }
    }
    VerticalLayout {
        padding: 20px;
        padding-top: 0;
        spacing: 16px;
        FormSection {
            title: "Commands";
            for command[i] in [
                { name: "Export video", keys: root.cmd + "R" },
                { name: "Cancel processing", keys: root.cmd + "." },
                { name: "Settings", keys: root.cmd + "," },
                { name: "About myUpscaler", keys: root.shift + root.cmd + "I" },
                { name: "Import video or folder", keys: root.cmd + "O" },
                { name: "Choose output folder", keys: root.shift + root.cmd + "O" },
                { name: "Show or hide adjustments", keys: root.option + root.cmd + "I" },
            ]: VerticalLayout {
                spacing: 8px;
                if i > 0: Divider { }
                FormRow {
                    label: command.name;
                    ShortcutBadge { keys: command.keys; }
                }
            }
        }
        FormSection {
            title: "Appearance";
            ChoiceRow {
                label: "Appearance";
                choices: ["System", "Light", "Dark"];
                menu-width: 110px;
                index: Theme.preference == ThemePreference.light ? 1 : Theme.preference == ThemePreference.dark ? 2 : 0;
                changed => {
                    Theme.preference = self.index == 1 ? ThemePreference.light
                        : self.index == 2 ? ThemePreference.dark : ThemePreference.system;
                }
            }
        }
    }
}

component AboutSheet inherits Sheet {
    VerticalLayout {
        padding-left: Theme.lg;
        padding-right: Theme.lg;
        padding-top: Theme.xl;
        padding-bottom: Theme.xl;
        spacing: Theme.lg;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 96px;
                height: 96px;
                border-radius: 12px;
                clip: true;
                drop-shadow-blur: 4px;
                drop-shadow-color: #0000001f;
                drop-shadow-offset-y: 2px;
                Image {
                    source: @image-url("icons/app-icon.png");
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
        Text {
            text: "MyUpscaler";
            font-size: 28px;
            font-weight: 700;
            color: Theme.accent;
        }
        Text {
            text: "Version " + App.version + " · MpVFX " + App.engine-version;
            font-size: Theme.body;
            color: Theme.secondary;
        }
        Divider { }
        Text {
            text: "Video restoration and upscaling for macOS, Windows and Linux.";
            font-size: Theme.body;
            color: Theme.text;
            wrap: word-wrap;
        }
        AboutSlint {
            height: 120px;
        }
        Rectangle {
            height: 34px;
            border-radius: 8px;
            background: Theme.accent.with-alpha(0.1);
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.3);
            accessible-role: button;
            accessible-label: "Visit GitHub Repository";
            HorizontalLayout {
                alignment: center;
                spacing: Theme.sm;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("icons/globe.svg");
                        width: 14px;
                        height: 14px;
                        colorize: Theme.accent;
                    }
                }
                Text {
                    text: "Visit GitHub Repository";
                    font-size: Theme.body;
                    font-weight: 500;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
            }
            TouchArea { clicked => { Actions.open-website(); } }
        }
        Rectangle {
            height: 32px;
            border-radius: 8px;
            background: Theme.secondary.with-alpha(0.1);
            accessible-role: button;
            accessible-label: "Close";
            Text {
                text: "Close";
                font-size: Theme.body;
                font-weight: 500;
                color: Theme.text;
            }
            TouchArea { clicked => { App.about-open = false; } }
        }
    }
}

export component AppWindow inherits Window {
    title: App.input-name == "" ? "myUpscaler" : App.input-name + " — myUpscaler";
    icon: @image-url("icons/app-icon.png");
    min-width: 720px;
    min-height: 600px;
    preferred-width: 1180px;
    preferred-height: 780px;
    background: Theme.window;
    default-font-family: Theme.font;
    default-font-size: Theme.body;
    forward-focus: keys;

    // The built-in widgets follow Slint's palette: keep it in step with the appearance setting.
    property <ThemePreference> appearance: Theme.preference;
    changed appearance => {
        Palette.color-scheme = self.appearance == ThemePreference.dark ? ColorScheme.dark
            : self.appearance == ThemePreference.light ? ColorScheme.light : ColorScheme.unknown;
    }
    property <bool> modal: App.settings-open || App.about-open || App.enlarged;

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                if App.enlarged || App.settings-open || App.about-open {
                    App.enlarged = false;
                    App.settings-open = false;
                    App.about-open = false;
                    return accept;
                }
                return reject;
            }
            if e.text == " " && !e.modifiers.control && !root.modal && App.can-play && !App.running {
                Actions.play-pause();
                return accept;
            }
            if !e.modifiers.control || root.modal {
                return reject;
            }
            if e.text == "r" && !e.modifiers.shift && !App.running && App.input-path != "" {
                Actions.run();
                return accept;
            }
            if e.text == "." && App.running && !App.cancelling {
                Actions.cancel();
                return accept;
            }
            if e.text == "," {
                App.settings-open = true;
                return accept;
            }
            if (e.text == "i" || e.text == "I") && e.modifiers.alt {
                App.inspector-visible = !App.inspector-visible;
                return accept;
            }
            if (e.text == "i" || e.text == "I") && e.modifiers.shift {
                App.about-open = true;
                return accept;
            }
            if (e.text == "o" || e.text == "O") && !App.running {
                if e.modifiers.shift {
                    Actions.choose-output-folder();
                } else {
                    Actions.import();
                }
                return accept;
            }
            reject
        }

        VerticalLayout {
            Toolbar { }
            HorizontalLayout {
                vertical-stretch: 1;
                main := ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: Theme.md;
                        alignment: start;
                        InputCard {
                            height: max(360px, main.visible-height - 140px);
                        }
                        LogCard { }
                    }
                }
                if App.inspector-visible: Rectangle {
                    width: 1px;
                    background: Theme.separator;
                }
                // 440 wide when the window has room for it, down to 320 in a small window.
                if App.inspector-visible: Inspector {
                    min-width: 320px;
                    preferred-width: 440px;
                    max-width: 440px;
                }
            }
            if App.input-path != "" || App.running: BottomBar { }
        }
    }

    if App.enlarged: Rectangle {
        background: #000000d9;
        TouchArea { double-clicked => { App.enlarged = false; } }
        VerticalLayout {
            padding: 40px;
            spacing: 20px;
            Rectangle {
                vertical-stretch: 1;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: App.preview;
                    image-fit: contain;
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                for hint[i] in ["Double-click to close", "•", "Press ESC"]: Text {
                    text: hint;
                    font-size: Theme.caption;
                    color: i == 1 ? #ffffff66 : #ffffff99;
                }
            }
        }
    }

    if App.settings-open: SettingsSheet {
        close => { App.settings-open = false; }
    }
    if App.about-open: AboutSheet {
        close => { App.about-open = false; }
    }
}
