// Layout pieces of the adjustments panel and the sheets: sections (a heading over rows), label-and-control rows, the
// parameter row (label, slider, value, reset), the disclosure header and notes. The input controls are in
// controls.slint.

import { Theme } from "theme.slint";
import { Toggle, SliderControl, Dropdown, TextField, Button, ButtonKind, ButtonSize } from "controls.slint";

export { Toggle, SliderControl, Dropdown, TextField, Button, ButtonKind, ButtonSize }

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.separator;
}

// A note under a control: small secondary text.
export component Caption inherits Text {
    font-size: Theme.subheadline;
    color: Theme.secondary;
    wrap: word-wrap;
}

// One section of a form: an optional heading above its rows.
export component FormSection inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    if root.title != "": Text {
        text: root.title;
        font-size: Theme.body;
        font-weight: 600;
        color: Theme.text;
    }
    @children
}

// A form row: the label on the left, the control on the right.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> enabled: true;
    spacing: 8px;
    min-height: Theme.control-height;
    Text {
        text: root.label;
        font-size: Theme.body;
        color: root.enabled ? Theme.text : Theme.disabled;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

export component ChoiceRow inherits FormRow {
    in property <[string]> choices;
    in-out property <int> index;
    in property <length> menu-width: 140px;
    in property <string> name: root.label;       // the control's accessible name
    callback changed();
    Dropdown {
        width: root.menu-width;
        model: root.choices;
        current-index <=> root.index;
        enabled: root.enabled;
        label: root.name;
        selected => { root.changed(); }
    }
}

export component SwitchRow inherits FormRow {
    in-out property <bool> checked;
    in property <string> name: root.label;
    callback changed();
    Toggle {
        checked <=> root.checked;
        enabled: root.enabled;
        label: root.name;
        toggled => { root.changed(); }
    }
}

export component FieldRow inherits FormRow {
    in-out property <string> value;
    in property <string> placeholder;
    in property <length> field-width: 60px;
    in property <string> name: root.label;
    callback changed();
    TextField {
        width: root.field-width;
        text <=> root.value;
        placeholder: root.placeholder;
        enabled: root.enabled;
        label: root.name;
        edited => { root.changed(); }
    }
}

// A field under its own label, for the rows of short fields ("Range  Y  CbCr").
export component StackedField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <length> field-width: 52px;
    in property <bool> enabled: true;
    callback changed();
    spacing: 2px;
    Text {
        text: root.label;
        font-size: Theme.subheadline;
        color: Theme.secondary;
    }
    TextField {
        width: root.field-width;
        text <=> root.value;
        placeholder: root.placeholder;
        enabled: root.enabled;
        label: root.label;
        edited => { root.changed(); }
    }
}

// Label, slider, value and a reset button. Committed when the drag ends.
export component ParameterRow inherits HorizontalLayout {
    in property <string> title;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <float> default-value;
    in property <int> digits: 2;
    in property <bool> enabled: true;
    callback changed();
    spacing: 8px;
    height: Theme.control-height;
    Text {
        text: root.title;
        width: 92px;
        font-size: Theme.body;
        color: root.enabled ? Theme.text : Theme.disabled;
        vertical-alignment: center;
        overflow: elide;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        slider := SliderControl {
            value: root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            enabled: root.enabled;
            label: root.title;
            released(v) => {
                root.value = v;
                root.changed();
            }
        }
    }
    Text {
        width: 44px;
        text: slider.value.to-fixed(root.digits);
        font-size: Theme.body;
        color: root.enabled ? Theme.text : Theme.disabled;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Rectangle {
        width: 20px;
        border-radius: Theme.control-radius;
        background: reset.pressed ? Theme.pressed : Theme.window;
        accessible-role: button;
        accessible-label: "Reset " + root.title;
        accessible-action-default => { reset.clicked(); }
        Image {
            source: @image-url("icons/reset.svg");
            width: 12px;
            height: 12px;
            colorize: root.enabled ? Theme.secondary : Theme.disabled;
        }
        reset := TouchArea {
            enabled: root.enabled;
            clicked => {
                slider.value = root.default-value;
                root.value = root.default-value;
                root.changed();
            }
        }
    }
}

// A disclosure group's header: a chevron that turns when open, then the label.
export component Disclosure inherits Rectangle {
    in property <string> title;
    in-out property <bool> expanded;
    in property <bool> enabled: true;
    height: Theme.control-height;
    accessible-role: button;
    accessible-label: root.title;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { touch.clicked(); }
    HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                width: 10px;
                height: 10px;
                colorize: root.enabled ? Theme.secondary : Theme.disabled;
            }
        }
        Text {
            text: root.title;
            font-size: Theme.body;
            font-weight: 600;
            color: root.enabled ? Theme.text : Theme.disabled;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.expanded = !root.expanded; }
    }
}
