// Layout pieces of the macOS app's views: cards (rounded panels on the window), grouped-form sections with their
// rows, the parameter row (label, slider, value, reset), disclosure headers and captions. The input controls are in
// controls.slint.

import { Theme } from "theme.slint";
import { Toggle, SliderControl, Dropdown, TextField, Button, ButtonKind, ButtonSize } from "controls.slint";

export { Toggle, SliderControl, Dropdown, TextField, Button, ButtonKind, ButtonSize }

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.separator;
}

// A rounded panel on the window background (the input and log cards).
export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.card-border;
}

// Small secondary text.
export component Caption inherits Text {
    font-size: Theme.subheadline;
    color: Theme.secondary;
    wrap: word-wrap;
}

// One section of a grouped form: an optional header above a rounded box of rows.
export component FormSection inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    if root.title != "": Text {
        x: 10px;
        text: root.title;
        font-size: Theme.body;
        font-weight: 600;
        color: Theme.text;
    }
    Rectangle {
        background: Theme.section;
        border-radius: Theme.section-radius;
        border-width: 1px;
        border-color: Theme.section-border;
        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            @children
        }
    }
}

// A panel header inside a section ("Quality & Scale" with its symbol).
export component PanelHeader inherits HorizontalLayout {
    in property <string> title;
    in property <image> icon;
    spacing: 6px;
    padding-bottom: 2px;
    VerticalLayout {
        alignment: center;
        Image {
            source: root.icon;
            width: 13px;
            height: 13px;
            colorize: Theme.accent;
        }
    }
    Text {
        text: root.title;
        font-size: Theme.subheadline;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

// A form row: the label on the left, the control on the right.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> small;       // caption-sized secondary label, as in the panels
    in property <bool> enabled: true;
    spacing: 8px;
    min-height: Theme.control-height;
    Text {
        text: root.label;
        font-size: root.small ? Theme.subheadline : Theme.body;
        color: root.small ? Theme.secondary : Theme.text;
        opacity: root.enabled ? 1 : 0.45;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

export component ChoiceRow inherits FormRow {
    in property <[string]> choices;
    in-out property <int> index;
    in property <length> menu-width: 140px;
    callback changed();
    Dropdown {
        width: root.menu-width;
        model: root.choices;
        current-index <=> root.index;
        enabled: root.enabled;
        label: root.label;
        selected => { root.changed(); }
    }
}

export component SwitchRow inherits FormRow {
    in-out property <bool> checked;
    in property <bool> mini;
    callback changed();
    Toggle {
        checked <=> root.checked;
        mini: root.mini;
        enabled: root.enabled;
        label: root.label;
        toggled => { root.changed(); }
    }
}

export component FieldRow inherits FormRow {
    in-out property <string> value;
    in property <string> placeholder;
    in property <length> field-width: 55px;
    callback changed();
    TextField {
        width: root.field-width;
        text <=> root.value;
        placeholder: root.placeholder;
        enabled: root.enabled;
        label: root.label;
        edited => { root.changed(); }
    }
}

// A labelled field stacked above its label's caption, for the rows of small fields ("Range  Y  CbCr").
export component StackedField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <length> field-width: 40px;
    in property <bool> enabled: true;
    callback changed();
    spacing: 2px;
    Text {
        text: root.label;
        font-size: Theme.caption;
        color: Theme.secondary;
    }
    TextField {
        width: root.field-width;
        text <=> root.value;
        placeholder: root.placeholder;
        enabled: root.enabled;
        label: root.label;
        edited => { root.changed(); }
    }
}

// Label, slider, value and a reset button ("Strength ——o—— 2.50 ↺"). Committed when the drag ends.
export component ParameterRow inherits HorizontalLayout {
    in property <string> title;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <float> default-value;
    in property <int> digits: 2;
    in property <bool> enabled: true;
    callback changed();
    spacing: 8px;
    height: 24px;
    Text {
        text: root.title;
        width: 70px;
        font-size: Theme.subheadline;
        font-weight: 500;
        color: Theme.text;
        opacity: root.enabled ? 1 : 0.45;
        vertical-alignment: center;
        overflow: elide;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        slider := SliderControl {
            value: root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            enabled: root.enabled;
            label: root.title;
            released(v) => {
                root.value = v;
                root.changed();
            }
        }
    }
    Text {
        width: 40px;
        text: slider.value.to-fixed(root.digits);
        font-size: Theme.subheadline;
        font-weight: 500;
        color: Theme.text;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Rectangle {
        width: 22px;
        accessible-role: button;
        accessible-label: "Reset " + root.title;
        accessible-action-default => { reset.clicked(); }
        Image {
            source: @image-url("icons/reset.svg");
            width: 12px;
            height: 12px;
            colorize: Theme.accent;
            opacity: root.enabled ? (reset.pressed ? 0.6 : 1) : 0.45;
        }
        reset := TouchArea {
            enabled: root.enabled;
            clicked => {
                slider.value = root.default-value;
                root.value = root.default-value;
                root.changed();
            }
        }
    }
}

// A disclosure group's header: a chevron that turns when open, then the label.
export component Disclosure inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <bool> has-icon;
    in-out property <bool> expanded;
    in property <bool> enabled: true;
    height: 22px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { touch.clicked(); }
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                width: 10px;
                height: 10px;
                colorize: Theme.secondary;
            }
        }
        if root.has-icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 13px;
                height: 13px;
                colorize: Theme.accent;
            }
        }
        Text {
            text: root.title;
            font-size: Theme.subheadline;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.expanded = !root.expanded; }
    }
}
