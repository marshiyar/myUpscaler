// Building blocks drawn from the theme tokens so they look identical on every platform: buttons, chips, tabs, and
// the rows and sections the adjustments panel is built from. The input controls are in controls.slint.

import { Theme } from "theme.slint";
import { Toggle, SliderControl, Dropdown, TextField } from "controls.slint";

export { Toggle, SliderControl, Dropdown, TextField }

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
}

// Small uppercase monospace heading for a group of rows.
export component SectionLabel inherits HorizontalLayout {
    in property <string> text;
    padding-top: Theme.md;
    padding-bottom: Theme.xs;
    Text {
        text: root.text.to-uppercase();
        font-family: Theme.mono;
        font-size: Theme.font-label;
        font-weight: 500;
        letter-spacing: 0.6px;
        color: Theme.muted;
    }
}

export component Hint inherits VerticalLayout {
    in property <string> text;
    padding-top: 2px;
    padding-bottom: 6px;
    Text {
        text: root.text;
        font-size: Theme.font-small;
        color: Theme.faint;
        wrap: word-wrap;
    }
}

// Ghost icon button, optionally with a label (toolbars, reset arrows).
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <length> icon-size: 16px;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    height: 28px;
    min-width: 28px;
    border-radius: Theme.radius-small;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.border
        : root.active ? Theme.accent-soft
        : touch.has-hover ? Theme.controls : transparent;
    animate background { duration: Theme.fast; easing: ease-out; }
    opacity: root.enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: root.label == "" ? 6px : 8px;
        padding-right: root.label == "" ? 6px : 10px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: root.icon-size;
                height: root.icon-size;
                colorize: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.muted;
            }
        }
        if root.label != "": Text {
            text: root.label;
            font-size: Theme.font-body;
            font-weight: 500;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export enum ButtonKind { primary, secondary, danger }

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 30px;
    min-width: layout.preferred-width;
    border-radius: Theme.radius;
    property <color> base: root.kind == ButtonKind.primary ? Theme.accent
        : root.kind == ButtonKind.danger ? Theme.danger : Theme.controls;
    background: !root.enabled ? root.base
        : touch.pressed ? (root.kind == ButtonKind.secondary ? Theme.border : root.base.darker(0.15))
        : touch.has-hover ? (root.kind == ButtonKind.secondary ? Theme.controls-hover : root.base.brighter(0.12))
        : root.base;
    border-width: root.kind == ButtonKind.secondary ? 1px : 0;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.fast; easing: ease-out; }
    layout := HorizontalLayout {
        padding-left: Theme.md;
        padding-right: Theme.md;
        spacing: 6px;
        alignment: center;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: root.kind == ButtonKind.secondary ? Theme.text : Theme.on-accent;
            }
        }
        Text {
            text: root.text;
            font-size: Theme.font-body;
            font-weight: 600;
            color: root.kind == ButtonKind.secondary ? Theme.text : Theme.on-accent;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A compact setting summary in the command bar; clicking it opens the setting.
export component Chip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label + " " + root.value;
    accessible-action-default => { root.clicked(); }
    height: 26px;
    min-width: layout.preferred-width;
    border-radius: Theme.radius-small;
    background: touch.has-hover && root.enabled ? Theme.controls-hover : Theme.controls;
    border-width: 1px;
    border-color: Theme.hairline;
    animate background { duration: Theme.fast; }
    layout := HorizontalLayout {
        padding-left: Theme.sm;
        padding-right: Theme.sm;
        spacing: 5px;
        alignment: center;
        if root.label != "": Text {
            text: root.label;
            font-size: Theme.font-small;
            color: Theme.muted;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            font-family: Theme.mono;
            font-size: Theme.font-small;
            font-weight: 500;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Tabs in a sunken track.
export component Tabs inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected;
    in property <bool> enabled: true;
    callback changed(int);
    height: 30px;
    border-radius: Theme.radius;
    background: Theme.canvas;
    border-width: 1px;
    border-color: Theme.hairline;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: Theme.radius-small;
            background: i == root.selected ? Theme.controls : tab-touch.has-hover ? Theme.controls.with-alpha(0.5) : transparent;
            border-width: i == root.selected ? 1px : 0;
            border-color: Theme.hairline;
            animate background { duration: Theme.fast; }
            accessible-role: tab;
            accessible-label: item;
            accessible-item-selected: i == root.selected;
            Text {
                text: item;
                font-size: Theme.font-small;
                font-weight: i == root.selected ? 600 : 500;
                color: i == root.selected ? Theme.text : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            tab-touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

// Label (and optional detail) on the left, a control on the right.
export component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    spacing: Theme.md;
    min-height: Theme.row-height;
    padding-top: root.detail == "" ? 0 : 3px;
    padding-bottom: root.detail == "" ? 0 : 3px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            font-size: Theme.font-body;
            color: Theme.text;
            overflow: elide;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: Theme.font-small;
            color: Theme.faint;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

export component ChoiceRow inherits Row {
    in property <[string]> choices;
    in-out property <int> index;
    in property <bool> enabled: true;
    callback changed();
    Dropdown {
        width: 150px;
        model: root.choices;
        current-index <=> root.index;
        enabled: root.enabled;
        label: root.label;
        selected => { root.changed(); }
    }
}

export component SwitchRow inherits Row {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback changed();
    Toggle {
        checked <=> root.checked;
        enabled: root.enabled;
        label: root.label;
        toggled => { root.changed(); }
    }
}

export component FieldRow inherits Row {
    in-out property <string> value;
    in property <string> placeholder;
    in property <length> field-width: 76px;
    in property <bool> enabled: true;
    callback changed();
    TextField {
        width: root.field-width;
        text <=> root.value;
        placeholder: root.placeholder;
        enabled: root.enabled;
        label: root.label;
        edited => { root.changed(); }
    }
}

// Label, value and reset above a full-width slider. The value is committed when the drag ends.
export component ParameterRow inherits VerticalLayout {
    in property <string> title;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <float> default-value;
    in property <int> digits: 2;
    in property <bool> enabled: true;
    callback changed();
    spacing: 2px;
    padding-top: 2px;
    padding-bottom: 4px;
    HorizontalLayout {
        spacing: Theme.xs;
        height: 22px;
        Text {
            text: root.title;
            font-size: Theme.font-body;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: slider.value.to-fixed(root.digits);
            font-family: Theme.mono;
            font-size: Theme.font-small;
            font-weight: 500;
            color: slider.value == root.default-value ? Theme.muted : Theme.accent;
            vertical-alignment: center;
        }
        IconButton {
            icon: @image-url("icons/reset.svg");
            icon-size: 12px;
            height: 22px;
            min-width: 22px;
            enabled: root.enabled && slider.value != root.default-value;
            accessible-label: "Reset " + root.title;
            clicked => {
                slider.value = root.default-value;
                root.value = root.default-value;
                root.changed();
            }
        }
    }
    slider := SliderControl {
        value: root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        enabled: root.enabled;
        label: root.title;
        released(v) => {
            root.value = v;
            root.changed();
        }
    }
}

// A thin determinate or indeterminate progress line.
export component ProgressLine inherits Rectangle {
    in property <float> progress;
    in property <bool> indeterminate;
    height: 3px;
    border-radius: 1.5px;
    background: Theme.hairline;
    clip: true;
    property <float> sweep: indeterminate ? Math.mod(animation-tick() / 1.2s, 1) : 0;
    Rectangle {
        x: root.indeterminate ? (root.width * 1.4 * root.sweep) - root.width * 0.4 : 0;
        width: root.indeterminate ? root.width * 0.4 : root.width * root.progress.clamp(0, 1);
        border-radius: 1.5px;
        background: Theme.accent;
        animate width { duration: Theme.base; easing: ease-out; }
    }
}

export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> message;
    alignment: center;
    spacing: Theme.md;
    padding: Theme.xl;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: Theme.controls;
            border-width: 1px;
            border-color: Theme.hairline;
            Image {
                source: root.icon;
                width: 26px;
                height: 26px;
                colorize: Theme.muted;
            }
        }
    }
    Text {
        text: root.title;
        font-size: Theme.font-title;
        font-weight: 600;
        color: Theme.text;
        horizontal-alignment: center;
    }
    Text {
        text: root.message;
        font-size: Theme.font-body;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    @children
}
