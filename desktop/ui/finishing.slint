// The finishing filters (the second restoration pass) of the Restore page: the same rows as the first pass, with
// fields where the first pass has sliders.

import { Settings, Actions } from "globals.slint";
import { ChoiceRow, SwitchRow, FieldRow, StackedField, ParameterRow } from "components.slint";

export component FinishingFilters inherits VerticalLayout {
    spacing: 8px;
    ChoiceRow {
        label: "Reduce noise";
        name: "Finishing denoise";
        choices: ["Off", "bm3d", "nlmeans", "hqdn3d", "Across frames"];
        index <=> Settings.denoise2;
        changed => { Actions.settings-changed(); }
    }
    if Settings.denoise2 > 0: FieldRow {
        label: "Strength";
        name: "Finishing denoise strength";
        value <=> Settings.denoise2-strength;
        changed => { Actions.settings-changed(); }
    }
    ParameterRow {
        title: "Remove halos";
        value <=> Settings.dering2;
        maximum: 10;
        step: 0.005;
        default-value: 0.5;
        changed => { Actions.settings-changed(); }
    }
    SwitchRow {
        label: "Sharpen";
        name: "Finishing sharpen";
        checked <=> Settings.sharpen2;
        changed => { Actions.settings-changed(); }
    }
    if Settings.sharpen2: ChoiceRow {
        label: "Method";
        name: "Finishing sharpen method";
        choices: ["Adaptive", "Classic"];
        index <=> Settings.sharpen2-method;
        changed => { Actions.settings-changed(); }
    }
    if Settings.sharpen2 && Settings.sharpen2-method == 0: FieldRow {
        label: "Strength";
        name: "Finishing CAS strength";
        value <=> Settings.cas2-strength;
        placeholder: "0.25";
        changed => { Actions.settings-changed(); }
    }
    if Settings.sharpen2 && Settings.sharpen2-method == 1: FieldRow {
        label: "Radius";
        name: "Finishing radius";
        value <=> Settings.usm2-radius;
        placeholder: "5";
        changed => { Actions.settings-changed(); }
    }
    if Settings.sharpen2 && Settings.sharpen2-method == 1: FieldRow {
        label: "Amount";
        name: "Finishing unsharp amount";
        value <=> Settings.usm2-amount;
        placeholder: "1.0";
        changed => { Actions.settings-changed(); }
    }
    ChoiceRow {
        label: "Remove banding";
        name: "Finishing deband";
        choices: ["Off", "Deband", "Gradfun", "Neo F3kdb (CPU)"];
        index <=> Settings.deband2;
        menu-width: 160px;
        changed => {
            if Settings.deband2 != 1 {
                Settings.f3kdb2 = false;
            }
            Actions.settings-changed();
        }
    }
    if (Settings.deband2 == 1 && Settings.f3kdb2) || Settings.deband2 == 3: HorizontalLayout {
        spacing: 8px;
        alignment: end;
        StackedField {
            label: "Range";
            value <=> Settings.f3kdb2-range;
            placeholder: "15";
            changed => { Actions.settings-changed(); }
        }
        StackedField {
            label: "Y";
            value <=> Settings.f3kdb2-y;
            placeholder: "64";
            changed => { Actions.settings-changed(); }
        }
        StackedField {
            label: "CbCr";
            value <=> Settings.f3kdb2-cbcr;
            placeholder: "64";
            changed => { Actions.settings-changed(); }
        }
    }
    if Settings.deband2 == 2 || (Settings.deband2 == 1 && !Settings.f3kdb2): FieldRow {
        label: "Strength";
        name: "Finishing deband strength";
        value <=> Settings.deband2-strength;
        placeholder: "0.015";
        changed => { Actions.settings-changed(); }
    }
    SwitchRow {
        label: "Grain";
        name: "Finishing grain";
        checked <=> Settings.grain2;
        changed => { Actions.settings-changed(); }
    }
    if Settings.grain2: FieldRow {
        label: "Strength";
        name: "Finishing grain strength";
        value <=> Settings.grain2-strength;
        placeholder: "1.0";
        changed => { Actions.settings-changed(); }
    }
}
