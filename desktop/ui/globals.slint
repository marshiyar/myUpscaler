// State the Rust side pushes in (App, Settings) and the actions it handles (Actions). Settings starts from the
// backend's factory options (set by Rust at startup), so the defaults live in one place: backend/src/options.rs.
// Choices are indexes into the option lists the interface shows; Rust maps them to the backend's names
// (src/settings.rs). The controls are those of the macOS app's adjustments panel.

export global Settings {
    // Upscale
    in-out property <int> scaler;                   // 0 Lanczos
    in-out property <float> crf: 20;
    in-out property <string> scale: "2";
    in-out property <string> fps: "60";
    in-out property <int> interpolation;            // 0 off, 1 MCI, 2 blend

    // Restore: primary restoration
    in-out property <int> denoise;                  // 0 off, then DENOISERS: BM3D, NLMeans, hqdn3d, ATADenoise
    in-out property <float> denoise-strength: 2.5;
    in-out property <float> dering;                 // 0 is off
    in-out property <bool> sharpen: true;
    in-out property <int> sharpen-method;           // 0 CAS, 1 unsharp mask
    in-out property <float> cas-strength: 0.25;
    in-out property <float> usm-radius: 5;
    in-out property <float> usm-amount: 1;
    in-out property <float> usm-threshold: 0.03;
    in-out property <bool> eq;
    in-out property <float> contrast: 1;
    in-out property <float> brightness: 0;
    in-out property <float> saturation: 1;

    // Restore: finishing filters (the second pass)
    in-out property <int> denoise2;                 // 0 off, then DENOISERS
    in-out property <string> denoise2-strength;
    in-out property <float> dering2;                // 0 is off
    in-out property <bool> sharpen2;
    in-out property <int> sharpen2-method;
    in-out property <string> cas2-strength;
    in-out property <string> usm2-radius;
    in-out property <string> usm2-amount;
    in-out property <int> deband2;                  // 0 off, 1 deband (or f3kdb), 2 gradfun, 3 Neo F3kdb
    in-out property <string> deband2-strength;
    in-out property <string> f3kdb2-range;
    in-out property <string> f3kdb2-y;
    in-out property <string> f3kdb2-cbcr;
    in-out property <bool> grain2;
    in-out property <string> grain2-strength;
    // True when the loaded deband method is f3kdb (shown as Deband with its three fields).
    in-out property <bool> f3kdb;
    in-out property <bool> f3kdb2;

    // Processor
    in-out property <int> deblock;                  // 0 off, 1 weak, 2 strong
    in-out property <string> deblock-alpha;
    in-out property <string> deblock-beta;
    in-out property <string> deblock-gamma;
    in-out property <string> deblock-delta;
    in-out property <bool> deblock-valid: true;
    in-out property <int> deband;                   // 0 off, 1 deband (or f3kdb), 2 gradfun, 3 Neo F3kdb
    in-out property <string> deband-strength;
    in-out property <string> f3kdb-range;
    in-out property <string> f3kdb-y;
    in-out property <string> f3kdb-cbcr;
    in-out property <string> grain;
    in-out property <bool> decimate: true;

    // Output
    in-out property <bool> custom-output;
    in-out property <string> output-folder;
    in-out property <int> hwaccel;
    in-out property <int> encoder;
    in-out property <bool> hevc;
    in-out property <bool> ten-bit;
    in-out property <bool> faststart: true;
    in-out property <bool> force-8bit;
    in-out property <string> audio-bitrate;
    in-out property <int> preset;                   // veryfast, faster, medium
    in-out property <string> threads;
    in-out property <string> aq-mode;
    in-out property <string> psy-rd;
    in-out property <string> x265-deblock1;
    in-out property <string> x265-deblock2;

    // Range of the primary denoise slider for the chosen denoiser.
    in-out property <float> denoise-min: 0;
    in-out property <float> denoise-max: 20;
    in-out property <float> denoise-default: 2.5;
}

export global App {
    in property <string> input-path;
    in property <string> input-name;
    in property <bool> is-image;
    in property <image> preview;
    in property <bool> has-preview;
    in property <bool> preview-busy;
    in property <string> preview-note;
    in property <[image]> thumbnails;
    in property <[string]> thumbnail-times;
    in property <bool> thumbnails-loading;
    in-out property <int> selected-frame;
    in-out property <bool> enlarged;

    // The player: the imported video (source 0) or the finished export (source 1).
    in property <bool> can-play;
    in property <bool> playing;
    in property <image> player-frame;
    in property <bool> has-player-frame;
    in-out property <float> position;               // seconds
    in property <string> position-text: "0:00";
    in property <float> duration;
    in property <string> duration-text: "0:00";
    in-out property <int> source;
    in property <bool> has-result;

    in property <bool> running;
    in property <bool> cancelling;
    in property <bool> progress-known;
    in property <float> progress;                   // 0..1
    in property <string> status: "Import a video to begin";
    in property <bool> completed;
    in property <string> completed-output;
    in property <string> fps-text: "0";
    in property <string> time-text: "0:00";
    in property <string> eta-text: "--:--";
    in property <string> log;
    in property <string> predicted-output;
    in property <string> engine-version;
    in property <string> version;

    in property <[string]> hwaccels: ["none"];
    in property <[string]> encoders: ["auto", "cpu"];
    in property <[string]> presets;
    in property <bool> mac;                         // shortcuts read ⌘ rather than Ctrl

    in-out property <bool> inspector-visible;
    in-out property <int> page;                     // 0 Upscale, 1 Restore, 2 Processor, 3 Output
    in-out property <bool> about-open;
    in-out property <bool> settings-open;
    in-out property <bool> log-open;
}

export global Actions {
    callback import();
    callback import-folder();
    callback choose-output-folder();
    callback run();
    callback cancel();
    callback reset-settings();
    callback settings-changed();
    callback select-frame(int);
    callback play-pause();
    callback seek(float);
    callback seek-done();
    callback set-source(int);
    callback open-output();
    callback reveal-output();
    callback open-website();
    callback save-preset(string);
    callback apply-preset(int);
    callback update-preset(int);
    callback rename-preset(int, string);
    callback duplicate-preset(int);
    callback delete-preset(int);
}
