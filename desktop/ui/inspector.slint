// The adjustments panel, as the macOS app's WorkspaceInspector: a segmented picker (Upscale, Restore, Processor,
// Output) over sections of label-and-control rows. Locked while processing.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Settings, App, Actions } from "globals.slint";
import { SegmentedPicker } from "controls.slint";
import {
    Divider, Caption, FormSection, FormRow, ChoiceRow, SwitchRow, FieldRow, StackedField, ParameterRow,
    Disclosure, Dropdown, SliderControl, Button, ButtonKind, ButtonSize,
} from "components.slint";
import { OutputPage } from "output.slint";
import { FinishingFilters } from "finishing.slint";

component UpscalePage inherits VerticalLayout {
    spacing: Theme.md;
    FormSection {
        FormRow {
            label: "Scaler";
            Dropdown {
                width: 160px;
                model: ["Lanczos"];
                current-index <=> Settings.scaler;
                label: "Scaler";
            }
        }
    }
    Divider { }
    FormSection {
        title: "Quality & Scale";
        // Laid out as a ParameterRow without the reset button.
        HorizontalLayout {
            spacing: 8px;
            height: Theme.control-height;
            Text {
                text: "CRF";
                width: 76px;
                font-size: Theme.body;
                color: Theme.text;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                crf := SliderControl {
                    value: Settings.crf;
                    minimum: 0;
                    maximum: 51;
                    step: 1;
                    label: "CRF";
                    released(v) => {
                        Settings.crf = v;
                        Actions.settings-changed();
                    }
                }
            }
            Text {
                width: 44px;
                text: crf.value.round();
                font-size: Theme.body;
                color: Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Rectangle { width: 20px; }
        }
        Caption { text: "Lower is better."; }
        FieldRow {
            label: "Scale";
            value <=> Settings.scale;
            placeholder: "2.0";
            changed => { Actions.settings-changed(); }
        }
        FieldRow {
            label: "FPS";
            value <=> Settings.fps;
            placeholder: "60";
            changed => { Actions.settings-changed(); }
        }
        ChoiceRow {
            label: "Interpolation";
            choices: ["Off", "MCI", "Blend"];
            index <=> Settings.interpolation;
            changed => { Actions.settings-changed(); }
        }
    }
}

component RestorePage inherits VerticalLayout {
    spacing: Theme.md;
    in-out property <bool> finishing-open;
    FormSection {
        title: "Primary restoration";
        ChoiceRow {
            label: "Denoise";
            choices: ["Off", "bm3d", "nlmeans", "hqdn3d", "atadenoise"];
            index <=> Settings.denoise;
            changed => { Actions.settings-changed(); }
        }
        if Settings.denoise > 0: ParameterRow {
            title: "Strength";
            value <=> Settings.denoise-strength;
            minimum: Settings.denoise-min;
            maximum: Settings.denoise-max;
            step: 0.1;
            default-value: Settings.denoise-default;
            changed => { Actions.settings-changed(); }
        }
        ParameterRow {
            title: "Deringing";
            value <=> Settings.dering;
            maximum: 10;
            step: 0.005;
            default-value: 0.5;
            changed => { Actions.settings-changed(); }
        }
        SwitchRow {
            label: "Sharpen";
            checked <=> Settings.sharpen;
            changed => { Actions.settings-changed(); }
        }
        if Settings.sharpen: ChoiceRow {
            label: "Method";
            choices: ["CAS", "Unsharp mask"];
            index <=> Settings.sharpen-method;
            changed => { Actions.settings-changed(); }
        }
        if Settings.sharpen && Settings.sharpen-method == 0: ParameterRow {
            title: "Strength";
            value <=> Settings.cas-strength;
            step: 0.005;
            default-value: 0.25;
            changed => { Actions.settings-changed(); }
        }
        if Settings.sharpen && Settings.sharpen-method == 1: ParameterRow {
            title: "Matrix";
            value <=> Settings.usm-radius;
            minimum: 3;
            maximum: 23;
            step: 1;
            digits: 0;
            default-value: 5;
            changed => { Actions.settings-changed(); }
        }
        if Settings.sharpen && Settings.sharpen-method == 1: ParameterRow {
            title: "Amount";
            value <=> Settings.usm-amount;
            minimum: -2;
            maximum: 5;
            default-value: 1;
            changed => { Actions.settings-changed(); }
        }
    }
    Divider { }
    FormSection {
        SwitchRow {
            label: "Color equalizer";
            checked <=> Settings.eq;
            changed => { Actions.settings-changed(); }
        }
        if Settings.eq: ParameterRow {
            title: "Contrast";
            value <=> Settings.contrast;
            minimum: 0.5;
            maximum: 2;
            step: 0.005;
            default-value: 1;
            changed => { Actions.settings-changed(); }
        }
        if Settings.eq: ParameterRow {
            title: "Brightness";
            value <=> Settings.brightness;
            minimum: -0.1;
            maximum: 0.1;
            step: 0.005;
            digits: 3;
            default-value: 0;
            changed => { Actions.settings-changed(); }
        }
        if Settings.eq: ParameterRow {
            title: "Saturation";
            value <=> Settings.saturation;
            maximum: 2;
            step: 0.005;
            default-value: 1;
            changed => { Actions.settings-changed(); }
        }
    }
    Divider { }
    FormSection {
        Disclosure {
            title: "Finishing filters (Lanczos)";
            expanded <=> root.finishing-open;
        }
        if root.finishing-open: FinishingFilters { }
    }
}

component ProcessorPage inherits VerticalLayout {
    spacing: Theme.md;
    FormSection {
        ChoiceRow {
            label: "Deblock";
            choices: ["Off", "weak", "strong"];
            index <=> Settings.deblock;
            menu-width: 110px;
            changed => { Actions.settings-changed(); }
        }
        if Settings.deblock > 0: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                Text {
                    text: "Thresholds";
                    font-size: Theme.body;
                    color: Theme.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Button {
                    text: "Defaults";
                    size: ButtonSize.small;
                    clicked => {
                        Settings.deblock-alpha = "";
                        Settings.deblock-beta = "";
                        Settings.deblock-gamma = "";
                        Settings.deblock-delta = "";
                        Actions.settings-changed();
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                StackedField {
                    label: "alpha";
                    value <=> Settings.deblock-alpha;
                    placeholder: "0.098";
                    changed => { Actions.settings-changed(); }
                }
                StackedField {
                    label: "beta";
                    value <=> Settings.deblock-beta;
                    placeholder: "0.05";
                    changed => { Actions.settings-changed(); }
                }
                StackedField {
                    label: "gamma";
                    value <=> Settings.deblock-gamma;
                    placeholder: "0.05";
                    changed => { Actions.settings-changed(); }
                }
                StackedField {
                    label: "delta";
                    value <=> Settings.deblock-delta;
                    placeholder: "0.05";
                    changed => { Actions.settings-changed(); }
                }
            }
            if !Settings.deblock-valid: Text {
                text: "Invalid saved or draft thresholds; use values from 0 to 1 or Defaults.";
                font-size: Theme.subheadline;
                color: Theme.red;
                wrap: word-wrap;
            }
        }
        ChoiceRow {
            label: "Deband";
            choices: ["Off", "Deband", "Gradfun", "Neo F3kdb (CPU)"];
            index <=> Settings.deband;
            menu-width: 200px;
            changed => {
                if Settings.deband != 1 {
                    Settings.f3kdb = false;
                }
                Actions.settings-changed();
            }
        }
        if (Settings.deband == 1 && Settings.f3kdb) || Settings.deband == 3: HorizontalLayout {
            spacing: 8px;
            alignment: end;
            StackedField {
                label: "Range";
                value <=> Settings.f3kdb-range;
                placeholder: "15";
                changed => { Actions.settings-changed(); }
            }
            StackedField {
                label: "Y";
                value <=> Settings.f3kdb-y;
                placeholder: "64";
                changed => { Actions.settings-changed(); }
            }
            StackedField {
                label: "CbCr";
                value <=> Settings.f3kdb-cbcr;
                placeholder: "64";
                changed => { Actions.settings-changed(); }
            }
        }
        if Settings.deband != 3 && !(Settings.deband == 1 && Settings.f3kdb): FieldRow {
            label: "Strength";
            value <=> Settings.deband-strength;
            placeholder: "0.015";
            changed => { Actions.settings-changed(); }
        }
        FieldRow {
            label: "Grain";
            value <=> Settings.grain;
            placeholder: "1.0";
            changed => { Actions.settings-changed(); }
        }
    }
    Divider { }
    FormSection {
        SwitchRow {
            label: "Remove near-duplicate frames";
            checked <=> Settings.decimate;
            changed => { Actions.settings-changed(); }
        }
    }
    Divider { }
    FormSection {
        HorizontalLayout {
            alignment: start;
            Button {
                text: "Reset processing settings";
                clicked => { Actions.reset-settings(); }
            }
        }
    }
}

export component Inspector inherits Rectangle {
    in-out property <bool> finishing-open;
    background: Theme.window;
    VerticalLayout {
        VerticalLayout {
            padding: 12px;
            spacing: Theme.sm;
            SegmentedPicker {
                items: ["Upscale", "Restore", "Processor", "Output"];
                selected <=> App.page;
            }
            if App.running: Caption { text: "Settings are locked while processing."; }
        }
        Divider { }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                alignment: start;
                if App.page == 0: UpscalePage { }
                if App.page == 1: RestorePage {
                    finishing-open <=> root.finishing-open;
                }
                if App.page == 2: ProcessorPage { }
                if App.page == 3: OutputPage { }
            }
        }
    }
    // Settings are locked while processing; the pages can still be read.
    if App.running: TouchArea {
        y: 72px;
        height: root.height - 72px;
    }
}
