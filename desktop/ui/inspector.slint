// The adjustments panel, as the macOS app's WorkspaceInspector: a segmented picker (Upscale, Restore, Processor,
// Output) over a grouped form. Locked while processing.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Settings, App, Actions } from "globals.slint";
import { SegmentedPicker } from "controls.slint";
import {
    Divider, Caption, FormSection, PanelHeader, FormRow, ChoiceRow, SwitchRow, FieldRow, StackedField, ParameterRow,
    Disclosure, Dropdown, TextField, Toggle, SliderControl, Button, ButtonKind, ButtonSize,
} from "components.slint";
import { OutputPage } from "output.slint";
import { FinishingFilters } from "finishing.slint";

component UpscalePage inherits VerticalLayout {
    spacing: Theme.md;
    FormSection {
        FormRow {
            label: "Scaler";
            small: true;
            Dropdown {
                width: 160px;
                model: ["Lanczos"];
                current-index <=> Settings.scaler;
                label: "Scaler";
            }
        }
    }
    FormSection {
        PanelHeader {
            title: "Quality & Scale";
            icon: @image-url("icons/chart-bar.svg");
        }
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "CRF";
                    font-size: Theme.caption;
                    font-weight: 500;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
                Text {
                    text: crf.value.round();
                    font-size: Theme.caption;
                    font-weight: 500;
                    color: Theme.text;
                }
                Text {
                    text: "(Lower is better)";
                    font-size: Theme.caption;
                    color: Theme.secondary;
                }
            }
            crf := SliderControl {
                value: Settings.crf;
                minimum: 0;
                maximum: 51;
                step: 1;
                label: "CRF";
                released(v) => {
                    Settings.crf = v;
                    Actions.settings-changed();
                }
            }
        }
        Divider { }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            StackedField {
                label: "Scale";
                value <=> Settings.scale;
                placeholder: "2.0";
                field-width: 60px;
                changed => { Actions.settings-changed(); }
            }
            StackedField {
                label: "FPS";
                value <=> Settings.fps;
                placeholder: "60";
                field-width: 60px;
                changed => { Actions.settings-changed(); }
            }
        }
        Divider { }
        ChoiceRow {
            label: "Interpolation";
            small: true;
            choices: ["Off", "MCI", "Blend"];
            index <=> Settings.interpolation;
            changed => { Actions.settings-changed(); }
        }
    }
}

component RestorePage inherits VerticalLayout {
    spacing: Theme.md;
    in-out property <bool> finishing-open;
    FormSection {
        title: "Primary restoration";
        ChoiceRow {
            label: "Denoise";
            choices: ["Off", "bm3d", "nlmeans", "hqdn3d", "atadenoise"];
            index <=> Settings.denoise;
            changed => { Actions.settings-changed(); }
        }
        if Settings.denoise > 0: Divider { }
        if Settings.denoise > 0: ParameterRow {
            title: "Strength";
            value <=> Settings.denoise-strength;
            minimum: Settings.denoise-min;
            maximum: Settings.denoise-max;
            step: 0.1;
            default-value: Settings.denoise-default;
            changed => { Actions.settings-changed(); }
        }
        Divider { }
        ParameterRow {
            title: "Deringing";
            value <=> Settings.dering;
            maximum: 10;
            step: 0.005;
            default-value: 0.5;
            changed => { Actions.settings-changed(); }
        }
        Divider { }
        SwitchRow {
            label: "Sharpen";
            checked <=> Settings.sharpen;
            changed => { Actions.settings-changed(); }
        }
        if Settings.sharpen: Divider { }
        if Settings.sharpen: ChoiceRow {
            label: "Method";
            choices: ["CAS", "Unsharp mask"];
            index <=> Settings.sharpen-method;
            changed => { Actions.settings-changed(); }
        }
        if Settings.sharpen && Settings.sharpen-method == 0: Divider { }
        if Settings.sharpen && Settings.sharpen-method == 0: ParameterRow {
            title: "Strength";
            value <=> Settings.cas-strength;
            step: 0.005;
            default-value: 0.25;
            changed => { Actions.settings-changed(); }
        }
        if Settings.sharpen && Settings.sharpen-method == 1: Divider { }
        if Settings.sharpen && Settings.sharpen-method == 1: ParameterRow {
            title: "Matrix";
            value <=> Settings.usm-radius;
            minimum: 3;
            maximum: 23;
            step: 1;
            digits: 0;
            default-value: 5;
            changed => { Actions.settings-changed(); }
        }
        if Settings.sharpen && Settings.sharpen-method == 1: Divider { }
        if Settings.sharpen && Settings.sharpen-method == 1: ParameterRow {
            title: "Amount";
            value <=> Settings.usm-amount;
            minimum: -2;
            maximum: 5;
            default-value: 1;
            changed => { Actions.settings-changed(); }
        }
    }
    FormSection {
        SwitchRow {
            label: "Color equalizer";
            checked <=> Settings.eq;
            changed => { Actions.settings-changed(); }
        }
        if Settings.eq: Divider { }
        if Settings.eq: ParameterRow {
            title: "Contrast";
            value <=> Settings.contrast;
            minimum: 0.5;
            maximum: 2;
            step: 0.005;
            default-value: 1;
            changed => { Actions.settings-changed(); }
        }
        if Settings.eq: Divider { }
        if Settings.eq: ParameterRow {
            title: "Brightness";
            value <=> Settings.brightness;
            minimum: -0.1;
            maximum: 0.1;
            step: 0.005;
            digits: 3;
            default-value: 0;
            changed => { Actions.settings-changed(); }
        }
        if Settings.eq: Divider { }
        if Settings.eq: ParameterRow {
            title: "Saturation";
            value <=> Settings.saturation;
            maximum: 2;
            step: 0.005;
            default-value: 1;
            changed => { Actions.settings-changed(); }
        }
    }
    FormSection {
        Disclosure {
            title: "Finishing filters (Lanczos)";
            icon: @image-url("icons/sparkles.svg");
            has-icon: true;
            expanded <=> root.finishing-open;
        }
        if root.finishing-open: FinishingFilters { }
    }
}

component ProcessorPage inherits VerticalLayout {
    spacing: Theme.md;
    FormSection {
        ChoiceRow {
            label: "Deblock";
            small: true;
            choices: ["Off", "weak", "strong"];
            index <=> Settings.deblock;
            menu-width: 110px;
            changed => { Actions.settings-changed(); }
        }
        if Settings.deblock > 0: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                Caption {
                    text: "Thresholds";
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Button {
                    text: "Defaults";
                    size: ButtonSize.mini;
                    clicked => {
                        Settings.deblock-alpha = "";
                        Settings.deblock-beta = "";
                        Settings.deblock-gamma = "";
                        Settings.deblock-delta = "";
                        Actions.settings-changed();
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                StackedField {
                    label: "alpha";
                    value <=> Settings.deblock-alpha;
                    placeholder: "0.098";
                    field-width: 52px;
                    changed => { Actions.settings-changed(); }
                }
                StackedField {
                    label: "beta";
                    value <=> Settings.deblock-beta;
                    placeholder: "0.05";
                    field-width: 52px;
                    changed => { Actions.settings-changed(); }
                }
                StackedField {
                    label: "gamma";
                    value <=> Settings.deblock-gamma;
                    placeholder: "0.05";
                    field-width: 52px;
                    changed => { Actions.settings-changed(); }
                }
                StackedField {
                    label: "delta";
                    value <=> Settings.deblock-delta;
                    placeholder: "0.05";
                    field-width: 52px;
                    changed => { Actions.settings-changed(); }
                }
            }
            if !Settings.deblock-valid: Text {
                text: "Invalid saved or draft thresholds; use values from 0 to 1 or Defaults.";
                font-size: Theme.caption;
                color: Theme.red;
                wrap: word-wrap;
            }
        }
        Divider { }
        ChoiceRow {
            label: "Deband";
            small: true;
            choices: ["Off", "Deband", "Gradfun", "Neo F3kdb (CPU)"];
            index <=> Settings.deband;
            menu-width: 200px;
            changed => {
                if Settings.deband != 1 {
                    Settings.f3kdb = false;
                }
                Actions.settings-changed();
            }
        }
        if (Settings.deband == 1 && Settings.f3kdb) || Settings.deband == 3: HorizontalLayout {
            spacing: 6px;
            padding-left: 8px;
            alignment: start;
            StackedField {
                label: "Range";
                value <=> Settings.f3kdb-range;
                placeholder: "15";
                changed => { Actions.settings-changed(); }
            }
            StackedField {
                label: "Y";
                value <=> Settings.f3kdb-y;
                placeholder: "64";
                changed => { Actions.settings-changed(); }
            }
            StackedField {
                label: "CbCr";
                value <=> Settings.f3kdb-cbcr;
                placeholder: "64";
                changed => { Actions.settings-changed(); }
            }
        }
        if Settings.deband != 3 && !(Settings.deband == 1 && Settings.f3kdb): FieldRow {
            label: "Strength";
            small: true;
            padding-left: 8px;
            value <=> Settings.deband-strength;
            placeholder: "0.015";
            changed => { Actions.settings-changed(); }
        }
        Divider { }
        FieldRow {
            label: "Grain";
            small: true;
            value <=> Settings.grain;
            placeholder: "1.0";
            field-width: 50px;
            changed => { Actions.settings-changed(); }
        }
    }
    FormSection {
        SwitchRow {
            label: "Remove near-duplicate frames";
            checked <=> Settings.decimate;
            changed => { Actions.settings-changed(); }
        }
    }
    FormSection {
        HorizontalLayout {
            alignment: start;
            Button {
                text: "Reset processing settings";
                icon: @image-url("icons/reset.svg");
                has-icon: true;
                kind: ButtonKind.plain;
                clicked => { Actions.reset-settings(); }
            }
        }
    }
}

export component Inspector inherits Rectangle {
    in-out property <bool> finishing-open;
    background: Theme.form;
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.md;
            SegmentedPicker {
                items: ["Upscale", "Restore", "Processor", "Output"];
                selected <=> App.page;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: Theme.md;
                padding-right: Theme.md;
                padding-bottom: Theme.md;
                alignment: start;
                if App.page == 0: UpscalePage { }
                if App.page == 1: RestorePage {
                    finishing-open <=> root.finishing-open;
                }
                if App.page == 2: ProcessorPage { }
                if App.page == 3: OutputPage { }
            }
        }
    }
    // Settings are locked while processing.
    if App.running: TouchArea {
        y: 56px;
        height: root.height - 56px;
    }
    if App.running: Rectangle {
        y: 56px;
        height: root.height - 56px;
        background: Theme.form.with-alpha(0.45);
    }
}
