// The Output page of the adjustments panel, as in the macOS app: where the export goes, encoding and saved presets.

import { Theme } from "theme.slint";
import { Settings, App, Actions } from "globals.slint";
import {
    Divider, Caption, FormSection, FormRow, ChoiceRow, FieldRow, TextField, Button, ButtonKind, ButtonSize,
} from "components.slint";

// One saved preset: its name (or the field renaming it) and its actions.
component PresetRow inherits VerticalLayout {
    in property <string> name;
    in property <int> index;
    property <bool> renaming;
    property <string> draft;
    property <bool> confirm-delete;
    spacing: 4px;
    function commit-rename() {
        if root.draft != "" {
            Actions.rename-preset(root.index, root.draft);
        }
        root.renaming = false;
    }
    HorizontalLayout {
        spacing: 8px;
        height: Theme.control-height;
        if root.renaming: TextField {
            text <=> root.draft;
            placeholder: "Preset name";
            label: "Preset name";
            accepted => { root.commit-rename(); }
        }
        if !root.renaming: Text {
            text: root.name;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: root.renaming ? "Save name" : "Rename";
                size: ButtonSize.small;
                enabled: !App.running;
                clicked => {
                    if root.renaming {
                        root.commit-rename();
                    } else {
                        root.draft = root.name;
                        root.renaming = true;
                    }
                }
            }
        }
    }
    if !root.confirm-delete: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Button {
            text: "Apply";
            size: ButtonSize.small;
            enabled: !App.running;
            clicked => { Actions.apply-preset(root.index); }
        }
        Button {
            text: "Update";
            size: ButtonSize.small;
            enabled: !App.running;
            clicked => { Actions.update-preset(root.index); }
        }
        Button {
            text: "Duplicate";
            size: ButtonSize.small;
            clicked => { Actions.duplicate-preset(root.index); }
        }
        Button {
            text: "Delete";
            size: ButtonSize.small;
            destructive: true;
            clicked => { root.confirm-delete = true; }
        }
    }
    if root.confirm-delete: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: "Delete preset?";
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
        }
        Button {
            text: "Delete \"" + root.name + "\"";
            size: ButtonSize.small;
            destructive: true;
            clicked => {
                root.confirm-delete = false;
                Actions.delete-preset(root.index);
            }
        }
        Button {
            text: "Cancel";
            size: ButtonSize.small;
            clicked => { root.confirm-delete = false; }
        }
    }
}

export component OutputPage inherits VerticalLayout {
    in-out property <string> preset-name;
    spacing: Theme.md;
    FormSection {
        ChoiceRow {
            label: "Location";
            choices: ["Same folder", "Custom folder"];
            index: Settings.custom-output ? 1 : 0;
            menu-width: 130px;
            changed => {
                Settings.custom-output = self.index == 1;
                Actions.settings-changed();
            }
        }
        if Settings.custom-output: HorizontalLayout {
            spacing: 8px;
            height: Theme.control-height;
            Text {
                text: Settings.output-folder == "" ? "Choose an output folder" : Settings.output-folder;
                font-size: Theme.body;
                color: Theme.secondary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Choose";
                    size: ButtonSize.small;
                    clicked => { Actions.choose-output-folder(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: Theme.control-height;
            Text {
                text: "Output";
                font-size: Theme.body;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                text: App.input-path == "" ? "Choose a video first" : App.predicted-output;
                font-size: Theme.body;
                color: Theme.secondary;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
    Divider { }
    FormSection {
        title: "File";
        Caption { text: "Saves as MP4."; }
        ChoiceRow {
            label: "Run on";
            choices: App.devices;
            index <=> Settings.processing;
            enabled: !App.running;
            menu-width: 200px;
            changed => { Actions.settings-changed(); }
        }
        if App.device-note != "": Caption { text: App.device-note; }
        FieldRow {
            label: "CPU threads";
            value <=> Settings.threads;
            placeholder: "0 (auto)";
            changed => { Actions.settings-changed(); }
        }
    }
    Divider { }
    FormSection {
        title: "Saved Presets";
        HorizontalLayout {
            spacing: 8px;
            TextField {
                text <=> root.preset-name;
                placeholder: "Preset name";
                label: "Preset name";
                enabled: !App.running;
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Save current";
                    enabled: !App.running && root.preset-name != "";
                    clicked => {
                        Actions.save-preset(root.preset-name);
                        root.preset-name = "";
                    }
                }
            }
        }
        if App.preset-message != "": Caption { text: App.preset-message; }
        if App.presets.length == 0: Caption {
            text: "No presets yet.";
        }
        for name[i] in App.presets: PresetRow {
            name: name;
            index: i;
        }
    }
}
