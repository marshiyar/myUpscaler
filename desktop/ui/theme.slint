// Design tokens. Dark-first studio palette (a sunken canvas, flat panels, raised controls, hairline borders) with a
// matching light theme; Inter for the interface and Geist Mono for numbers and labels, embedded so every platform
// renders the same. Spacing follows a 4 px grid; motion uses short ease-out transitions.

import { Palette } from "std-widgets.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/GeistMono-Regular.ttf";
import "fonts/GeistMono-Medium.ttf";

export enum ThemePreference { system, light, dark }

export global Theme {
    in-out property <ThemePreference> preference;
    out property <bool> dark: preference == ThemePreference.dark ? true
        : preference == ThemePreference.light ? false
        : Palette.color-scheme != ColorScheme.light;

    // Type
    out property <string> font: "Inter";
    out property <string> mono: "Geist Mono";
    out property <length> font-title: 18px;
    out property <length> font-body: 13px;
    out property <length> font-small: 12px;
    out property <length> font-label: 10.5px;

    // Spacing (4 px grid) and shape
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 24px;
    out property <length> radius-small: 6px;
    out property <length> radius: 8px;
    out property <length> radius-large: 12px;
    out property <length> row-height: 28px;
    out property <length> control-height: 26px;

    // Motion
    out property <duration> fast: 140ms;
    out property <duration> base: 220ms;

    // Surfaces: the canvas is sunken, panels are flat, controls are raised.
    out property <color> background: dark ? #121316 : #ffffff;
    out property <color> panel: dark ? #101014 : #f8f8f8;
    out property <color> canvas: dark ? #060607 : #ececef;
    out property <color> controls: dark ? #1e1f22 : #eeeeef;
    out property <color> controls-hover: dark ? #26272b : #e4e4e7;
    out property <color> floating: dark ? #1e1f22f2 : #fffffff2;
    out property <color> border: dark ? #ffffff26 : #dcdcdf;
    out property <color> hairline: dark ? #ffffff14 : #e5e7eb;

    // Text
    out property <color> text: dark ? #f2f1ee : #18181b;
    out property <color> muted: dark ? #f2f1ee99 : #18181b99;
    out property <color> faint: dark ? #f2f1ee59 : #18181b59;

    // Accent and states
    out property <color> accent: #2d81ff;
    out property <color> accent-hover: #59a7ff;
    out property <color> accent-pressed: #1b63f5;
    out property <color> accent-soft: dark ? #2d81ff26 : #2d81ff1a;
    out property <color> on-accent: #ffffff;
    out property <color> success: dark ? #3fb36b : #308752;
    out property <color> danger: #d33242;
    out property <color> warning: #e8a33d;
}
