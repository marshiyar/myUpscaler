// The main column of the window, as in the macOS app's ContentView: the media pane (the import view, or the
// imported video's preview with its player and frame strip), the processing details under it, and the bottom bar
// with the status, the progress and the Export button.

import { Theme } from "theme.slint";
import { App, Actions } from "globals.slint";
import { Button, ButtonKind, ButtonSize, ProgressBar, SliderControl, SegmentedPicker } from "controls.slint";
import { Divider, Disclosure } from "components.slint";

// The empty workspace: one action.
component ImportView inherits VerticalLayout {
    alignment: center;
    spacing: 12px;
    padding: Theme.lg;
    Text {
        text: "Import a video";
        font-size: Theme.title2;
        color: Theme.text;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Button {
            text: "Browse";
            kind: ButtonKind.prominent;
            clicked => { Actions.import(); }
        }
        Button {
            text: "Choose a folder";
            clicked => { Actions.import-folder(); }
        }
    }
}

component Thumbnail inherits Rectangle {
    in property <image> image;
    in property <int> index;
    in property <string> time;
    property <bool> selected: App.selected-frame == root.index;
    width: 104px;
    height: 64px;
    accessible-role: button;
    accessible-label: "Frame " + (root.index + 1) + ", " + root.time;
    accessible-action-default => { Actions.select-frame(root.index); }
    Image {
        width: parent.width;
        height: parent.height;
        source: root.image;
        image-fit: cover;
    }
    // The selected frame is outlined in the accent colour.
    if root.selected: Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
    }
    Rectangle {
        x: 0;
        y: 0;
        width: number.preferred-width + 8px;
        height: 14px;
        background: root.selected ? Theme.accent : #000000;
        number := Text {
            text: root.index + 1;
            font-size: Theme.caption;
            color: #ffffff;
        }
    }
    TouchArea {
        clicked => { Actions.select-frame(root.index); }
    }
}

// Play / pause, the time, the scrubber and the duration; Original | Result once an export finished.
component Transport inherits HorizontalLayout {
    out property <bool> scrubbing: scrub.dragging;
    spacing: 10px;
    height: 24px;
    Rectangle {
        width: 26px;
        border-radius: Theme.control-radius;
        background: play.pressed ? Theme.pressed : play.has-hover ? Theme.hover : Theme.window;
        accessible-role: button;
        accessible-label: App.playing ? "Pause" : "Play";
        accessible-action-default => { Actions.play-pause(); }
        Image {
            source: App.playing ? @image-url("icons/pause-fill.svg") : @image-url("icons/play-fill.svg");
            width: 14px;
            height: 14px;
            colorize: Theme.text;
        }
        play := TouchArea {
            clicked => { Actions.play-pause(); }
        }
    }
    Text {
        text: App.position-text;
        font-size: Theme.subheadline;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-alignment: right;
        min-width: 34px;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        scrub := SliderControl {
            value <=> App.position;
            maximum: max(0.01, App.duration);
            step: 0.001;
            label: "Playback position";
            moved(v) => { Actions.seek(v); }
            released => { Actions.seek-done(); }
        }
    }
    Text {
        text: App.duration-text;
        font-size: Theme.subheadline;
        color: Theme.secondary;
        vertical-alignment: center;
        min-width: 34px;
    }
    if App.has-result: SegmentedPicker {
        width: 150px;
        items: ["Original", "Result"];
        selected <=> App.source;
        changed(i) => { Actions.set-source(i); }
    }
}

// The imported video: its name and the preview's state, the preview with the player's controls, and the frame
// strip. Paused on the original, the preview shows the adjustments; playing, scrubbing or showing the export, it
// shows the video's own frames.
component MediaView inherits VerticalLayout {
    property <bool> raw: App.has-player-frame && (App.playing || App.source == 1 || transport.scrubbing);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Image {
                source: App.is-image ? @image-url("icons/image.svg") : @image-url("icons/film.svg");
                width: 13px;
                height: 13px;
                colorize: Theme.secondary;
            }
        }
        Text {
            text: App.input-name;
            font-size: Theme.body;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: App.running ? "Preview frozen while processing"
                : App.preview-busy && App.has-preview ? "Updating preview…" : "Approximate preview";
            font-size: Theme.subheadline;
            color: Theme.secondary;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: App.is-image ? "Change image" : "Change video";
            enabled: !App.running;
            clicked => { Actions.import(); }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        min-height: 160px;
        background: Theme.stage;
        clip: true;
        if App.has-preview || root.raw: Image {
            width: parent.width;
            height: parent.height;
            source: root.raw ? App.player-frame : App.preview;
            image-fit: contain;
            accessible-role: image;
            accessible-label: "Adjusted video preview";
        }
        if !App.has-preview && !root.raw: Text {
            width: parent.width - 2 * Theme.md;
            text: App.preview-note != "" ? App.preview-note : "The preview will appear here when available.";
            font-size: Theme.body;
            color: #b4b4b4;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        TouchArea {
            enabled: App.has-preview && !App.running;
            double-clicked => { App.enlarged = true; }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: App.can-play ? 6px : 0;
        padding-bottom: App.can-play ? 6px : 0;
        transport := Transport {
            visible: App.can-play;
            height: App.can-play ? 24px : 0;
        }
    }
    if App.thumbnails.length > 0: Divider { }
    if App.thumbnails.length > 0: Flickable {
        height: 80px;
        content-width: strip.preferred-width;
        strip := HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            for image[i] in App.thumbnails: Thumbnail {
                image: image;
                index: i;
                time: App.thumbnail-times[i];
            }
        }
    }
}

// The media pane fills the main column: the import view until something is imported.
export component MediaPane inherits Rectangle {
    clip: true;
    if App.input-path == "": ImportView { }
    if App.input-path != "": MediaView { }
    // The preview and the player are locked while processing.
    if App.running: TouchArea { }
    // A file is dragged over the window.
    if App.dropping && !App.running: Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        Rectangle {
            y: parent.height - self.height;
            height: 28px;
            background: Theme.accent;
            Text {
                text: "Drop to import";
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.on-accent;
            }
        }
    }
}

// The processing log, under the media pane.
export component LogPane inherits VerticalLayout {
    Divider { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        Disclosure {
            title: "Processing details";
            expanded <=> App.log-open;
        }
    }
    if App.log-open: Rectangle {
        height: 170px;
        background: Theme.well;
        log-view := Flickable {
            content-height: max(self.height, log-text.preferred-height + 16px);
            property <string> log: App.log;
            changed log => {
                self.content-y = min(0px, self.height - self.content-height);
            }
            log-text := Text {
                x: 12px;
                y: 8px;
                width: log-view.width - 24px;
                text: App.log == "" ? "Export details will appear here." : App.log;
                font-family: Theme.mono;
                font-size: Theme.log;
                color: App.log == "" ? Theme.secondary : Theme.text;
                wrap: word-wrap;
            }
        }
    }
}

// Status, progress, the finished file's actions and the Export / Cancel button, pinned to the bottom of the window.
export component BottomBar inherits Rectangle {
    background: Theme.bar;
    height: layout.preferred-height;
    Divider {
        y: 0;
        width: parent.width;
    }
    layout := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: App.status;
                    font-size: Theme.body;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if App.running && App.progress-known: Text {
                    text: (App.progress * 100).round() + "%";
                    font-size: Theme.subheadline;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            if App.running: ProgressBar {
                progress: App.progress;
                indeterminate: !App.progress-known;
                accessible-role: progress-indicator;
                accessible-label: App.status;
            }
            if App.running: HorizontalLayout {
                spacing: 14px;
                alignment: start;
                for line in ["Processing: " + App.fps-text + " fps", "Media time: " + App.time-text,
                    "Remaining: " + App.eta-text]: Text {
                    text: line;
                    font-size: Theme.subheadline;
                    color: Theme.secondary;
                }
            }
        }
        if App.completed && !App.running && App.completed-output != "": VerticalLayout {
            alignment: center;
            Button {
                text: App.mac ? "Show in Finder" : "Show in Folder";
                clicked => { Actions.reveal-output(); }
            }
        }
        if App.completed && !App.running && App.completed-output != "": VerticalLayout {
            alignment: center;
            Button {
                text: "Open";
                clicked => { Actions.open-output(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                width: 130px;
                kind: ButtonKind.prominent;
                text: App.cancelling ? "Stopping…" : App.running ? "Cancel" : "Export video";
                enabled: !App.cancelling && (App.running || App.input-path != "");
                clicked => {
                    if App.running {
                        Actions.cancel();
                    } else {
                        Actions.run();
                    }
                }
            }
        }
    }
}
